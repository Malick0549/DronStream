# Copy to .env and replace every CHANGE_ME value with long random values.
DOMAIN=stream.example.com
ENVIRONMENT=production
FORCE_LOOPBACK=false

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_ADMIN_PASSWORD
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
POSTGRES_DB=dronestream
POSTGRES_USER=dronestream
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_ALPHANUMERIC_PASSWORD

TURN_SHARED_SECRET=CHANGE_ME_LONG_RANDOM_TURN_SECRET
TURN_CREDENTIAL_TTL_SECONDS=3600
TURN_URLS=["turn:stream.example.com:3478?transport=udp","turn:stream.example.com:3478?transport=tcp"]
# For a VPS behind provider NAT or a home-hosted VM, use PUBLIC_IP/VM_LAN_IP.
TURN_EXTERNAL_IP=203.0.113.10/192.168.1.50
CORS_ORIGINS=["https://stream.example.com"]
FFMPEG_PATH=ffmpeg
